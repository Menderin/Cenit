{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@cenit/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@cenit/contracts/auth": [
        "../../packages/contracts/src/auth/index.ts"
      ],
      "@cenit/contracts/purchases": [
        "../../packages/contracts/src/purchases/index.ts"
      ],
      "@cenit/contracts/purchases/examples": [
        "../../packages/contracts/src/purchases/examples.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
