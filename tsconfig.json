{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@cenit/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@cenit/contracts/academic": [
        "./packages/contracts/src/academic/index.ts"
      ],
      "@cenit/contracts/academic/examples": [
        "./packages/contracts/src/academic/examples.ts"
      ],
      "@cenit/contracts/auth": [
        "./packages/contracts/src/auth/index.ts"
      ],
      "@cenit/contracts/purchases": [
        "./packages/contracts/src/purchases/index.ts"
      ],
      "@cenit/contracts/purchases/examples": [
        "./packages/contracts/src/purchases/examples.ts"
      ],
      "@cenit/contracts/personnel": [
        "./packages/contracts/src/personnel/index.ts"
      ],
      "@cenit/contracts/assets": [
        "./packages/contracts/src/assets/index.ts"
      ]
    }
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "db/**/*.ts",
    "tests/integration/**/*.ts",
    "vitest*.ts",
    "drizzle.config.ts",
    "tests/e2e/**/*.ts",
    "playwright*.config.ts"
  ]
}
