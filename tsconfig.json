{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "types": ["node"],
    "paths": { "@cenit/contracts": ["./packages/contracts/src/index.ts"], "@cenit/contracts/academic": ["./packages/contracts/src/academic/index.ts"] }
  },
  "include": ["apps/api/src/**/*.ts", "packages/contracts/src/**/*.ts", "db/**/*.ts", "tests/integration/**/*.ts", "vitest*.ts", "drizzle.config.ts"]
}
