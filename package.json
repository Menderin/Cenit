{
  "name": "cenit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "node deploy/scripts/test-production.mjs",
    "build": "npm run build --workspace @cenit/contracts && npm run build --workspace @cenit/api && npm run build --workspace @cenit/web",
    "start": "node apps/api/dist/server.js",
    "test:e2e:production": "node deploy/scripts/test-production.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @cenit/web",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:academic": "npm run build --workspace @cenit/contracts && npm run build --workspace @cenit/api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node deploy/migrate.cjs",
    "catalog:check": "tsx db/seeds/load-academic.ts --check",
    "catalog:load": "tsx db/seeds/load-academic.ts --publish",
    "auth:prepare-demo": "tsx db/seeds/auth-demo.ts",
    "academic:prepare-demo": "tsx db/seeds/prepare-academic-demo.ts",
    "build:web": "npm run build --workspace @cenit/web",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:academic": "playwright test --config playwright.academic.config.ts",
    "dev": "node deploy/scripts/dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
