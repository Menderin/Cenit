# Local environment only. Database secrets are generated by setup-local.py.
# Keep this example without passwords; configure demo passwords in the ignored .env.
COMPOSE_PROJECT_NAME=cenit-local
CENIT_DB_PORT=55432
CENIT_HTTP_PORT=8081
# Switch to ./deploy/nginx/cenit.conf only after building and starting the application.
CENIT_NGINX_CONFIG=./deploy/nginx/bootstrap.conf
# Agree these demo passwords within the team and fill them only in the ignored .env.
# All three are required by npm run dev; 12–128 characters. No credentials in Git.
CENIT_DEMO_ADMINISTRATIVO_PASSWORD=
CENIT_DEMO_ESTUDIANTE_PASSWORD=
CENIT_DEMO_DOCENTE_PASSWORD=
# Optional identity provider. Exact accounts must be authorized separately.
AUTH_GOOGLE_ENABLED=false
# AUTH_GOOGLE_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
# Optional notebook OCR: prepare/start explicitly; API reads these via dev launcher.
# OCR_URL=http://127.0.0.1:8090
# CAPTURE_RECEIPT_KEY_FILE=.local/secrets/capture-receipt-key

# Sheets is optional. Never put service-account credentials in this file or Git.
CENIT_PURCHASE_SHEETS_SYNC_ENABLED=false
# CENIT_PURCHASE_SHEETS_ID=<id of a dedicated TEST spreadsheet>
# CENIT_PURCHASE_SHEETS_KEY_FILE=.local/secrets/purchase-sheets-key.json
