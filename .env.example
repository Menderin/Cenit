# Local environment only. Database secrets are generated by setup-local.py.
# Keep this example without passwords; configure demo passwords in the ignored .env.
COMPOSE_PROJECT_NAME=cenit-local
CENIT_DB_PORT=55432
CENIT_HTTP_PORT=8081
# Switch to ./deploy/nginx/cenit.conf only after building and starting the application.
CENIT_NGINX_CONFIG=./deploy/nginx/bootstrap.conf
# Agree these demo passwords within the team and fill them only in the ignored .env.
# All three are required by npm run dev; 12–128 characters. No credentials in Git.
CENIT_DEMO_ADMINISTRATIVO_PASSWORD=
CENIT_DEMO_ESTUDIANTE_PASSWORD=
CENIT_DEMO_DOCENTE_PASSWORD=
